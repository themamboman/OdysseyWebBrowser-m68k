# Writes owb_buildinfo.h with the build date and git commit, so the version shown to users
# (about page, screen title, $VER) is never stale. Runs at every build; the header is only
# rewritten when its content changes, so nothing recompiles needlessly.
#   cmake -DSRC=<source dir> -DOUT=<header path> -P OWBBuildInfo.cmake

string(TIMESTAMP owb_date "%d.%m.%Y")

execute_process(COMMAND git rev-parse --short=7 HEAD
    WORKING_DIRECTORY "${SRC}" OUTPUT_VARIABLE owb_commit
    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE owb_result)
if (NOT owb_result EQUAL 0 OR owb_commit STREQUAL "")
    set(owb_commit "nogit")
else ()
    # "+" marks a build with uncommitted changes to tracked files.
    execute_process(COMMAND git diff --quiet HEAD
        WORKING_DIRECTORY "${SRC}" RESULT_VARIABLE owb_dirty ERROR_QUIET)
    if (owb_dirty EQUAL 1)
        set(owb_commit "${owb_commit}+")
    endif ()
endif ()

file(WRITE "${OUT}.tmp"
"/* Generated by Source/cmake/OWBBuildInfo.cmake at every build. Do not edit. */
#define OWB_BUILD_DATE \"${owb_date}\"
#define OWB_GIT_COMMIT \"${owb_commit}\"
")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUT}.tmp" "${OUT}")
file(REMOVE "${OUT}.tmp")
